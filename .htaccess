RewriteEngine On
Options -MultiViews

# Redirect to HTTPS in production
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options DENY
    Header always set X-Content-Type-Options nosniff
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hide .htaccess file
<Files ".htaccess">
    Require all denied
</Files>

# Prevent access to config files
<FilesMatch "\.config\.php$">
    Require all denied
</FilesMatch>

# Prevent access to core files
<FilesMatch "\.(inc|log)$">
    Require all denied
</FilesMatch>

# If request is for existing file or directory, don't rewrite
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicitly exclude admin folder from SPA fallback (let admin PHP handle it)
RewriteRule ^admin(/|$) - [L]

# API and customer routes (handled by PHP front controllers)
RewriteRule ^api/(.*)$ api.php [QSA,L]
RewriteRule ^customer/(.*)$ customer/index.php?page=$1 [QSA,L]

# Admin internal routing (if you want pretty URLs mapped into admin/index.php)
RewriteRule ^admin/(.*)$ admin/index.php?page=$1 [QSA,L]

# Default SPA / front controller fallback
RewriteRule ^(.*)$ index.php [QSA,L]