RewriteEngine On

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options DENY
    Header always set X-Content-Type-Options nosniff
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hide .htaccess file
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Prevent access to config files
<Files "*.config.php">
    Order allow,deny
    Deny from all
</Files>

# Prevent access to core files
<FilesMatch "\.(inc|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# URL routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# API routes
RewriteRule ^api/(.*)$ api.php [QSA,L]

# Admin routes
RewriteRule ^admin/(.*)$ admin/index.php?page=$1 [QSA,L]

# Customer routes
RewriteRule ^customer/(.*)$ customer/index.php?page=$1 [QSA,L]

# Default route
RewriteRule ^(.*)$ index.php [QSA,L]